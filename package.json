{
  "name": "agent-terminal",
  "displayName": "SideMates: Terminal Agents for VS Code",
  "description": "A dedicated terminal in the secondary sidebar for running CLI coding agents such as pi",
  "version": "1.2.0",
  "publisher": "patrick-lindemann",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/patrick-lindemann/agent-terminal"
  },
  "bugs": {
    "url": "https://github.com/patrick-lindemann/agent-terminal/issues"
  },
  "homepage": "https://github.com/patrick-lindemann/agent-terminal#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "keywords": [
    "pi",
    "ai",
    "terminal",
    "sidebar",
    "agent",
    "gemini",
    "aider",
    "cli",
    "assistant"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentTerminalContainer",
          "title": "SideMates",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "agentTerminalContainer": [
        {
          "type": "webview",
          "id": "agentTerminal.terminalView",
          "name": "Terminal",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "agentTerminal.newTab",
        "title": "New Terminal Tab",
        "category": "SideMates",
        "icon": "$(add)"
      },
      {
        "command": "agentTerminal.newTabWithProfile",
        "title": "Use Profile…",
        "category": "SideMates",
        "icon": "$(chevron-down)"
      },
      {
        "command": "agentTerminal.newTabWithCommand",
        "title": "New Terminal Tab with Custom Command…",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.closeTab",
        "title": "Close Terminal Tab",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.nextTab",
        "title": "Next Terminal Tab",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.previousTab",
        "title": "Previous Terminal Tab",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.switchTab",
        "title": "Switch Tab…",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "title": "Switch to Tab at Position",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.closeTabFromMenu",
        "title": "Close",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.closeOtherTabs",
        "title": "Close Others",
        "category": "SideMates"
      },
      {
        "command": "agentTerminal.manageProfiles",
        "title": "Manage Profiles",
        "category": "SideMates"
      }
    ],
    "keybindings": [
      {
        "command": "agentTerminal.newTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+t",
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.closeTab",
        "key": "ctrl+shift+w",
        "mac": "cmd+w",
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.nextTab",
        "key": "ctrl+pagedown",
        "mac": "cmd+alt+right",
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.previousTab",
        "key": "ctrl+pageup",
        "mac": "cmd+alt+left",
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchTab",
        "key": "ctrl+tab",
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+1",
        "mac": "cmd+1",
        "args": 1,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+2",
        "mac": "cmd+2",
        "args": 2,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+3",
        "mac": "cmd+3",
        "args": 3,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+4",
        "mac": "cmd+4",
        "args": 4,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+5",
        "mac": "cmd+5",
        "args": 5,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+6",
        "mac": "cmd+6",
        "args": 6,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+7",
        "mac": "cmd+7",
        "args": 7,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+8",
        "mac": "cmd+8",
        "args": 8,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      },
      {
        "command": "agentTerminal.switchToTabAt",
        "key": "alt+9",
        "mac": "cmd+9",
        "args": 9,
        "when": "agentTerminal.focused || focusedView == 'agentTerminal.terminalView'"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "agentTerminal.closeTabFromMenu",
          "when": "webviewId == 'agentTerminal.terminalView' && webviewSection == 'tab'",
          "group": "2_close@1"
        },
        {
          "command": "agentTerminal.closeOtherTabs",
          "when": "webviewId == 'agentTerminal.terminalView' && webviewSection == 'tab'",
          "group": "2_close@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentTerminal.closeTabFromMenu",
          "when": "false"
        },
        {
          "command": "agentTerminal.closeOtherTabs",
          "when": "false"
        },
        {
          "command": "agentTerminal.switchToTabAt",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SideMates",
      "properties": {
        "agentTerminal.profiles": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Profiles for new tabs: a name and the command line it runs, in the order listed here. The first one opens with `+`; `⌄` lists all of them. Write arguments as in a shell, with quotes where needed. To set environment variables for one profile, put them before the command with `env`, e.g. `env NAME=value command` (macOS and Linux); `#agentTerminal.env#` sets them for all profiles. A known agent in the command line (`claude`, `codex`, `agy`, `gemini`, `opencode`, `pi`, `agent`, `copilot`, `grok`, `hermes`, `devin`), also behind a wrapper such as tmux, gives the tab its logo and status support.\n\nWhen empty, there is a profile for each known agent that is installed."
        },
        "agentTerminal.autoRun": {
          "type": "boolean",
          "default": true,
          "description": "With directMode off: run the profile's command in the shell when a tab opens"
        },
        "agentTerminal.shell": {
          "type": "string",
          "default": "",
          "description": "Custom shell path (empty = system default)"
        },
        "agentTerminal.env": {
          "type": "object",
          "default": {},
          "description": "Additional environment variables"
        },
        "agentTerminal.directMode": {
          "type": "boolean",
          "default": true,
          "description": "Run command directly without shell wrapper (cleaner output, but no shell features)"
        },
        "agentTerminal.onExit": {
          "type": "string",
          "enum": [
            "auto",
            "close",
            "restart",
            "keep"
          ],
          "enumDescriptions": [
            "Close the tab after a clean exit (code 0); keep it open after an error. Closing the last tab opens a new one.",
            "Always close the tab when the process exits.",
            "Restart the command in the same tab. Falls back to 'keep' if the process exits within 3 seconds of starting.",
            "Keep the tab open; press Enter to restart or Esc to close."
          ],
          "default": "auto",
          "description": "What happens when the terminal's process exits (e.g. after /exit)"
        },
        "agentTerminal.programStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show agent status (working, needs input, done, error) on tabs. Agents such as pi, Claude Code and Codex report it through the [Program Status Protocol (OSC 7501)](https://www.superlogical.com/rex/docs/build/program-status). Other programs fall back to `#agentTerminal.promptNotification#`."
        },
        "agentTerminal.autoTabTitles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Name tabs with the agent's shortened terminal title, e.g. `Refactor API client` from Claude Code's conversation summary or a pi session named with `/name`. When off, tabs show the profile's name."
        },
        "agentTerminal.tabTitleWords": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "markdownDescription": "Maximum number of words in a tab's name with `#agentTerminal.autoTabTitles#`, e.g. 4 turns `Refactor the API client for v2` into `Refactor API client v2`. Filler words such as `the` or `die` are left out for about 60 languages."
        },
        "agentTerminal.statusColors": {
          "type": "boolean",
          "default": true,
          "description": "Color the status icons on tabs (working, needs input, done, failed) and, for needs input, done and failed, the tab's name. The icons' shapes show the status without color."
        },
        "agentTerminal.monochromeIcons": {
          "type": "boolean",
          "default": false,
          "description": "Show agent logos in the text color instead of their brand colors."
        },
        "agentTerminal.confirmClose": {
          "type": "boolean",
          "default": true,
          "description": "Ask before closing a tab whose agent is working or waiting for input, since closing ends its session."
        },
        "agentTerminal.promptNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification indicator on tab when terminal is waiting for user input"
        },
        "agentTerminal.promptNotificationDelay": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "description": "Delay in milliseconds before showing the notification after output stops"
        },
        "agentTerminal.promptPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional regex patterns to detect when terminal is waiting for input (e.g., '^mybot> $'). Built-in patterns detect most CLI AI tools automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm run compile",
    "compile": "npm run compile:extension && npm run copy:xterm-css && npm run compile:media",
    "compile:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-pty --format=cjs --platform=node",
    "compile:media": "esbuild media/main.ts --bundle --outfile=media/main.js --format=iife --platform=browser --loader:.svg=text",
    "copy:xterm-css": "node -e \"require('fs').copyFileSync('node_modules/@xterm/xterm/css/xterm.css', 'media/xterm.css')\"",
    "watch": "concurrently -k \"npm:watch:extension\" \"npm:watch:media\"",
    "rebuild": "npx @electron/rebuild --version 43.8.3",
    "postinstall": "npm run rebuild",
    "package": "vsce package",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p media/tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "watch:extension": "npm run compile:extension -- --watch",
    "watch:media": "npm run compile:media -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run compile && tsc -p tsconfig.tests.json && vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@electron/rebuild": "^4.0.2",
    "@types/node": "^22.0.0",
    "@types/stopword": "^2.0.3",
    "@types/vscode": "^1.106.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "stopword": "^3.1.5",
    "typescript": "^5.3.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  }
}
